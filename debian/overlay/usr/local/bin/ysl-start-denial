#!/bin/sh
# Start the Denial session on /dev/tty1 (see ../home/ysl/.bash_profile).
#
# Denial is a Flutter Wayland compositor.  On a phone port there are three
# interesting failure modes, all of them silent from the outside:
#   * no /dev/dri/card0 at all   -> panel/DRM did not bind (DTB mismatch)
#   * the process dies instantly -> missing lib, engine, seat or DRM master
#   * the process hangs          -> no Wayland socket ever appears
# All three are detected here, logged to ~/.local/state/denial/session.log,
# and end in a shell on tty1 so the phone is still reachable (serial + ssh).
set -u

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Denial
export XDG_CURRENT_DESKTOP=Denial
export LIBSEAT_BACKEND=logind
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/denial"
mkdir -p "$state_dir"
chmod 0700 "$state_dir"
log="$state_dir/session.log"
exec >>"$log" 2>&1

printf '\n=== Redmi S2 Debian/Denial session %s ===\n' "$(date -Iseconds)"
echo "uid=$(id -u) tty=$(tty 2>/dev/null || echo none)"
echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
echo "kernel=$(cat /etc/redmi-s2-kernel-release 2>/dev/null)"
ls -l /dev/dri 2>&1
ls -l "$XDG_RUNTIME_DIR" 2>&1 | head -20
timeout 5 loginctl session-status 2>&1 | head -25
timeout 5 systemctl --user is-system-running 2>&1
timeout 20 /usr/bin/denial-session --check 2>&1 || true

if [ ! -e /dev/dri/card0 ]; then
	echo "ysl-start-denial: no /dev/dri/card0; panel/DRM did not bind" >&2
	echo "  dmesg | grep -Ei 'msm|dsi|panel|ysl' for the reason" >&2
	exec /bin/bash -l
fi

run_denial() {
	mode=$1
	if [ "$mode" = "dbus" ]; then
		dbus-run-session -- /usr/bin/denial-session --start-locked &
	else
		/usr/bin/denial-session --start-locked &
	fi
	pid=$!
	i=0
	while [ "$i" -lt 30 ]; do
		if ! kill -0 "$pid" 2>/dev/null; then
			wait "$pid"
			rc=$?
			echo "$mode: exited rc=$rc after ${i}s"
			return "$rc"
		fi
		if ls "$XDG_RUNTIME_DIR"/wayland-* >/dev/null 2>&1; then
			echo "$mode: wayland socket up after ${i}s"
			wait "$pid"
			rc=$?
			echo "$mode: exited rc=$rc"
			return "$rc"
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "$mode: no wayland socket after 30s, killing pid $pid"
	kill "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
	return 124
}

echo "ysl-start-denial: starting denial-session --start-locked"
run_denial direct
rc=$?
if [ "$rc" -ne 0 ]; then
	echo "ysl-start-denial: retrying inside dbus-run-session"
	run_denial dbus
	rc=$?
fi
if [ "$rc" -eq 0 ]; then
	exit 0
fi

echo "ysl-start-denial: Denial failed (rc=$rc); dropping to a shell"
echo "ysl-start-denial: full log: $log"
exec /bin/bash -l
